# Preserva os bytes das evidencias C04, incluindo os finais de linha coletados.
/docs/avaliacao/evidencias-c04/** -text whitespace=cr-at-eol
# Fontes e protocolo C04 foram medidos com LF; manter os hashes apos checkout.
/docs/avaliacao/c04/** text eol=lf
/docs/avaliacao/C04-protocolo.md text eol=lf
# Preserva os bytes das evidencias C05, incluindo espacos das fontes copiadas.
/docs/avaliacao/evidencias-c05/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
/docs/avaliacao/c05/** text eol=lf
/docs/avaliacao/C05-protocolo.md text eol=lf
